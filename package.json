{
  "name": "hall-of-faze",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:backend && npm run test:media && npm run test:community && npm run test:sponsor && npm run test:vault && npm run test:profile",
    "test:backend": "node --experimental-strip-types --test \"tests/backend/*.test.mts\"",
    "test:media": "node --test \"tests/media/*.test.mjs\"",
    "storage:setup": "node --env-file=.env.local scripts/storage-setup.mjs",
    "test:community": "node --experimental-strip-types --test \"tests/community/*.test.mts\"",
    "seed:community": "node scripts/seed-community.mjs",
    "test:sponsor": "node --experimental-strip-types --test \"tests/sponsor/*.test.mts\"",
    "test:profile": "node --experimental-strip-types --test \"tests/profile/*.test.mts\"",
    "test:vault": "node --experimental-strip-types --test \"tests/vault/*.test.mts\""
  },
  "dependencies": {
    "mongoose": "^9.12.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
